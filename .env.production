# DASH Production Environment Configuration
# Copy this file to .env and fill in your values.

# Application
DASH_ENV=production
DASH_DEBUG=false
DASH_LOG_LEVEL=INFO
DASH_HOST=0.0.0.0
DASH_PORT=8000

# CORS - comma-separated origins allowed
DASH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DASH_DATABASE_URL=postgresql+asyncpg://dash:dash@localhost:5432/dash

# Redis
DASH_REDIS_URL=redis://localhost:6379/0

# Security - REQUIRED: Generate a strong random key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DASH_JWT_SECRET_KEY=CHANGEME

# AI Provider (openai or ollama)
DASH_AI_PROVIDER=openai
DASH_OPENAI_API_KEY=sk-your-key-here
DASH_OPENAI_MODEL=gpt-4o-mini

# Ollama (if using local model)
# DASH_OLLAMA_BASE_URL=http://localhost:11434
# DASH_OLLAMA_MODEL=llama3.2:1b

# Optional: Disable GPU acceleration in Electron (set to 1 to disable)
# DASH_DISABLE_GPU=0

