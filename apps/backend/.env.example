# DASH Backend Configuration
# Copy this file to .env and adjust settings

# Environment
DASH_ENV=development
DASH_DEBUG=true
DASH_LOG_LEVEL=INFO
DASH_HOST=0.0.0.0
DASH_PORT=8000

# CORS
DASH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DASH_DATABASE_URL=postgresql+asyncpg://dash:dash@localhost:5432/dash

# Redis (optional, for caching)
DASH_REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASH_JWT_SECRET_KEY=changeme-to-a-secure-random-key
DASH_JWT_ALGORITHM=HS256
DASH_ACCESS_TOKEN_EXPIRE_MINUTES=15
DASH_REFRESH_TOKEN_EXPIRE_DAYS=30
DASH_PASSWORD_HASH_ITERATIONS=390000

# AI Provider
DASH_AI_PROVIDER=ollama
# DASH_AI_PROVIDER=openai
# DASH_OPENAI_API_KEY=sk-...
DASH_OPENAI_MODEL=gpt-4o-mini
DASH_OLLAMA_BASE_URL=http://localhost:11434
DASH_OLLAMA_MODEL=llama3.2:1b

