# DASH Mobile Backend Configuration
# Copy this file to .env and fill in your values.

# Backend IP address:
#   Android emulator → use 10.0.2.2 (maps to host localhost)
#   Physical device  → use your PC's local network IP (e.g. 192.168.1.x)
DASH_SERVER_IP=10.0.2.2
DASH_SERVER_PORT=8000

# Device authentication tokens (paste from DASH backend pairing)
DASH_ACCESS_TOKEN=placeholder_token
DASH_REFRESH_TOKEN=placeholder_refresh_token

# Firebase App Check (optional, leave blank to disable)
FIREBASE_APPCHECK_DEBUG_TOKEN=
